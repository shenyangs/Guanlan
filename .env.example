# 观澜 / Guanlan optional environment variables
# Copy to .env only when you need the corresponding optional capability.
# Do not paste browser cookies, tokens, proxy passwords, or private keys here unless you understand the risk.
# Prefer `guanlan configure` for local config and `guanlan doctor --check-config` for secret-risk scanning.

# Optional search backend key
# EXA_API_KEY=exa-your-key-here

# Optional GitHub token for higher rate limits
# GITHUB_TOKEN=ghp_your_token_here

# Optional video / podcast transcription key
# GROQ_API_KEY=gsk_your-key-here

# Optional proxy for public web requests. Avoid embedding credentials when possible.
# GUANLAN_PROXY_URL=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Optional local read-only HTTP service token when binding beyond 127.0.0.1
# GUANLAN_SERVE_TOKEN=change-me

# Optional telemetry controls. Telemetry is intentionally low-content: no query, URL, body, Cookie, Token, or local path.
# GUANLAN_TELEMETRY=1
# GUANLAN_TELEMETRY_ENDPOINT=https://metrics.example/v1/events
# GUANLAN_FEEDBACK_ENDPOINT=https://metrics.example/v1/feedback

# Optional hotboard detail API key. Catalog commands work from packaged local data without this key.
# GUANLAN_HOTBOARD_API_KEY=your-key-here

# Safety switches for diagnostics / tests
# GUANLAN_SKIP_SENSITIVE_PROBES=1
# GUANLAN_UPDATE_CHECK=1
